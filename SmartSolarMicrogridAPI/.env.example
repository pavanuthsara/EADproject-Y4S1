# Copy this file to ".env" (same folder) and fill in your own values.
# ".env" is git-ignored and must never be committed. Only this example is committed.
#
# Nested config keys use a double underscore instead of a colon:
#   MongoDbSettings__ConnectionString  ->  MongoDbSettings:ConnectionString
# Real environment variables always take priority over values in this file.

# Required. MongoDB connection string (local or Atlas).
MongoDbSettings__ConnectionString=mongodb+srv://<username>:<password>@<cluster>.mongodb.net/?appName=<appName>

# Optional. Defaults come from appsettings.json.
# MongoDbSettings__DatabaseName=SmartSolarMicrogridDB
# MongoDbSettings__PingTimeoutSeconds=5

# Allowed frontend origins, one line per origin (used outside Development,
# where any origin is allowed).
Cors__AllowedOrigins__0=http://localhost:3000
Cors__AllowedOrigins__1=http://localhost:5173

# Reserved for authentication (not used yet). Generate a long random value,
# e.g. with: openssl rand -base64 64
Jwt__SecretKey=<generate-a-long-random-value>
