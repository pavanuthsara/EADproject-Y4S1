<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="24dp">

    <!-- Loading State Container -->
    <LinearLayout
        android:id="@+id/containerLoading"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="24dp"
        android:visibility="gone">

        <ProgressBar
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_marginBottom="16dp" />

        <TextView
            android:id="@+id/textLoadingMsg"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Verifying QR code with server..."
            android:textColor="?attr/colorOnSurface"
            android:textSize="16sp" />
    </LinearLayout>

    <!-- Error State Container -->
    <LinearLayout
        android:id="@+id/containerError"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="16dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:layout_marginBottom="12dp"
            android:src="@drawable/ic_lock"
            app:tint="?attr/colorError" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Verification Failed"
            android:textColor="?attr/colorError"
            android:textSize="20sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textErrorMessage"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="20dp"
            android:gravity="center"
            android:text="Unable to verify reservation."
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonCloseError"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Close" />
    </LinearLayout>

    <!-- Verified Success Content Container -->
    <LinearLayout
        android:id="@+id/containerVerified"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:visibility="visible">

        <!-- Top Verified Badge -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_marginBottom="16dp">

            <ImageView
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_check_circle"
                app:tint="?attr/colorPrimary" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="12dp"
                android:layout_weight="1"
                android:orientation="vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Valid Reservation"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/textReservationNo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="RES-000000"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="13sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/badgeStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="?attr/colorPrimaryContainer"
                android:paddingHorizontal="10dp"
                android:paddingVertical="4dp"
                android:text="APPROVED"
                android:textColor="?attr/colorOnPrimaryContainer"
                android:textSize="12sp"
                android:textStyle="bold" />
        </LinearLayout>

        <!-- Divider -->
        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:background="?attr/colorOutlineVariant"
            android:layout_marginBottom="16dp" />

        <!-- Details Grid -->
        <TableLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:stretchColumns="1"
            android:layout_marginBottom="24dp">

            <TableRow android:layout_marginBottom="10dp">
                <TextView
                    android:text="Prosumer NIC:"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="14sp" />
                <TextView
                    android:id="@+id/textProsumerNic"
                    android:gravity="end"
                    android:text="123456789V"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </TableRow>

            <TableRow android:layout_marginBottom="10dp">
                <TextView
                    android:text="Transfer Type:"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="14sp" />
                <TextView
                    android:id="@+id/textDirection"
                    android:gravity="end"
                    android:text="Drop-off"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </TableRow>

            <TableRow android:layout_marginBottom="10dp">
                <TextView
                    android:text="Energy Volume:"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="14sp" />
                <TextView
                    android:id="@+id/textEnergyKwh"
                    android:gravity="end"
                    android:text="0.0 kWh"
                    android:textColor="?attr/colorPrimary"
                    android:textSize="15sp"
                    android:textStyle="bold" />
            </TableRow>

            <TableRow android:layout_marginBottom="10dp">
                <TextView
                    android:text="Scheduled Time:"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="14sp" />
                <TextView
                    android:id="@+id/textSlotTime"
                    android:gravity="end"
                    android:text="2026-10-01 10:00"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="13sp" />
            </TableRow>

            <TableRow>
                <TextView
                    android:text="Station / Node:"
                    android:textColor="?attr/colorOnSurfaceVariant"
                    android:textSize="14sp" />
                <TextView
                    android:id="@+id/textStationId"
                    android:gravity="end"
                    android:text="STATION-01"
                    android:textColor="?attr/colorOnSurface"
                    android:textSize="13sp" />
            </TableRow>
        </TableLayout>

        <!-- Finalize Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonConfirmFinalize"
            android:layout_width="match_parent"
            android:layout_height="54dp"
            android:text="@string/finalize_transfer"
            android:textSize="15sp"
            android:textStyle="bold"
            app:cornerRadius="12dp"
            app:icon="@drawable/ic_bolt"
            app:iconGravity="textStart" />

        <!-- Cancel Button -->
        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonCancel"
            style="@style/Widget.Material3.Button.TextButton"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="@string/cancel" />
    </LinearLayout>

    <!-- Completion Success State Container -->
    <LinearLayout
        android:id="@+id/containerCompleteSuccess"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="20dp"
        android:visibility="gone">

        <ImageView
            android:layout_width="64dp"
            android:layout_height="64dp"
            android:layout_marginBottom="16dp"
            android:src="@drawable/ic_check_circle"
            app:tint="?attr/colorPrimary" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Transfer Completed!"
            android:textColor="?attr/colorOnSurface"
            android:textSize="22sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/textCompleteTimestamp"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:layout_marginBottom="24dp"
            android:text="Recorded successfully on server."
            android:textColor="?attr/colorOnSurfaceVariant"
            android:textSize="14sp" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonDoneSuccess"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:text="Done"
            app:cornerRadius="12dp" />
    </LinearLayout>

</LinearLayout>
