<?xml version="1.0" encoding="utf-8"?><!--
   Backup and device-transfer rules for Android 12 and higher.
   See https://developer.android.com/about/versions/12/backup-restore#xml-changes
   The encrypted session file is excluded: its key lives in the Android Keystore and does not
   move with a backup or transfer, so the copy could not be decrypted on the new device.
-->
<data-extraction-rules>
    <cloud-backup>
        <exclude domain="sharedpref" path="secure_session.xml" />
    </cloud-backup>
    <device-transfer>
        <exclude domain="sharedpref" path="secure_session.xml" />
    </device-transfer>
</data-extraction-rules>
