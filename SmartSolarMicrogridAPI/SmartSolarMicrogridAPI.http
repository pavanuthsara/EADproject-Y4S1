@SmartSolarMicrogridAPI_HostAddress = http://localhost:5014

### API health check
GET {{SmartSolarMicrogridAPI_HostAddress}}/api/health
Accept: application/json

### Database connection check
GET {{SmartSolarMicrogridAPI_HostAddress}}/api/health/database
Accept: application/json

### Register a solar station (Backoffice token)
POST {{SmartSolarMicrogridAPI_HostAddress}}/api/stations
Authorization: Bearer {{backofficeToken}}
Content-Type: application/json

{
  "stationName": "Colombo Central Hub",
  "stationCode": "COL-01",
  "latitude": 6.9271,
  "longitude": 79.8612,
  "addressLine": "1 Galle Road",
  "city": "Colombo",
  "capacityKwh": 500,
  "totalBays": 4,
  "operatingSchedule": "06:00-18:00"
}

### Create a slot inside a station (Backoffice token) - 201
POST {{SmartSolarMicrogridAPI_HostAddress}}/api/stations/{{stationId}}/slots
Authorization: Bearer {{backofficeToken}}
Content-Type: application/json

{
  "startTime": "2026-10-08T09:00:00Z",
  "endTime": "2026-10-08T10:00:00Z",
  "totalPositions": 3,
  "capacityKwh": 50,
  "supportedDirections": ["Inject", "Draw"]
}

### Edit a slot (Backoffice token) - replaces every field
PUT {{SmartSolarMicrogridAPI_HostAddress}}/api/stations/{{stationId}}/slots/{{slotId}}
Authorization: Bearer {{backofficeToken}}
Content-Type: application/json

{
  "startTime": "2026-10-08T09:00:00Z",
  "endTime": "2026-10-08T10:00:00Z",
  "totalPositions": 4,
  "capacityKwh": 60,
  "supportedDirections": ["Inject"]
}

### Close a slot to new bookings (Backoffice or GridOperator token)
PATCH {{SmartSolarMicrogridAPI_HostAddress}}/api/stations/{{stationId}}/slots/{{slotId}}/availability
Authorization: Bearer {{gridOperatorToken}}
Content-Type: application/json

{
  "open": false
}

### Delete a slot (Backoffice token) - 400 while it has Pending/Approved reservations
DELETE {{SmartSolarMicrogridAPI_HostAddress}}/api/stations/{{stationId}}/slots/{{slotId}}
Authorization: Bearer {{backofficeToken}}

### List a station's slots (any signed-in token; prosumers only see bookable ones)
GET {{SmartSolarMicrogridAPI_HostAddress}}/api/stations/{{stationId}}/slots
Authorization: Bearer {{gridOperatorToken}}

### List the bookings on one slot (staff token)
GET {{SmartSolarMicrogridAPI_HostAddress}}/api/reservations/history?slotId={{slotId}}
Authorization: Bearer {{gridOperatorToken}}

### Approve a reservation (Backoffice or GridOperator token)
PUT {{SmartSolarMicrogridAPI_HostAddress}}/api/reservations/{{reservationId}}/approve
Authorization: Bearer {{gridOperatorToken}}

### Reject a reservation with a reason (Backoffice or GridOperator token) - releases the slot capacity
PUT {{SmartSolarMicrogridAPI_HostAddress}}/api/reservations/{{reservationId}}/reject
Authorization: Bearer {{gridOperatorToken}}
Content-Type: application/json

{
  "reason": "Battery maintenance that day"
}

### Update a station's daily operating hours (Backoffice or GridOperator token)
PUT {{SmartSolarMicrogridAPI_HostAddress}}/api/stations/{{stationId}}/operating-schedule
Authorization: Bearer {{gridOperatorToken}}
Content-Type: application/json

{
  "operatingSchedule": "06:00-18:00"
}

### Deactivate a station (Backoffice token) - 400 while it has Pending/Approved reservations
PUT {{SmartSolarMicrogridAPI_HostAddress}}/api/stations/{{stationId}}/deactivate
Authorization: Bearer {{backofficeToken}}

### Create an energy reservation (Prosumer token) - 201 with a Pending summary
POST {{SmartSolarMicrogridAPI_HostAddress}}/api/reservations
Authorization: Bearer {{prosumerToken}}
Content-Type: application/json

{
  "stationId": "{{stationId}}",
  "slotId": "{{slotId}}",
  "direction": "Inject",
  "requestedKwh": 25
}

### Update a reservation (Prosumer token) - any of slotId, direction, requestedKwh
PUT {{SmartSolarMicrogridAPI_HostAddress}}/api/reservations/{{reservationId}}
Authorization: Bearer {{prosumerToken}}
Content-Type: application/json

{
  "requestedKwh": 40
}

### Cancel a reservation (Prosumer token) - 200 with the Cancelled summary, 409 if already cancelled
DELETE {{SmartSolarMicrogridAPI_HostAddress}}/api/reservations/{{reservationId}}
Authorization: Bearer {{prosumerToken}}

### Verify scanned QR code (Grid Operator or Backoffice token)
POST {{SmartSolarMicrogridAPI_HostAddress}}/api/transfers/verify
Authorization: Bearer {{gridOperatorToken}}
Content-Type: application/json

{
  "qrToken": "qr-token-example-12345"
}

### Finalize energy transfer job (Grid Operator or Backoffice token)
POST {{SmartSolarMicrogridAPI_HostAddress}}/api/transfers/{{reservationId}}/complete
Authorization: Bearer {{gridOperatorToken}}
