<?xml version="1.0" encoding="utf-8"?><!--
   Backup rules for Android 11 and lower.
   See https://developer.android.com/guide/topics/data/autobackup
   The encrypted session file is excluded: its key lives in the Android Keystore and is not
   backed up, so a restored copy could not be decrypted on the new device.
-->
<full-backup-content>
    <exclude domain="sharedpref" path="secure_session.xml" />
</full-backup-content>
