<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fillViewport="true"
    android:background="?android:colorBackground">

    <LinearLayout
        android:id="@+id/listContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="24dp">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="My Reservations"
            android:textColor="@color/text"
            android:textSize="28sp"
            android:fontFamily="sans-serif-black"
            android:layout_marginBottom="20dp"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/buttonNewBooking"
            android:layout_width="match_parent"
            android:layout_height="56dp"
            android:text="Book a New Slot"
            android:textColor="@color/on_primary"
            android:textSize="15sp"
            android:textStyle="bold"
            app:backgroundTint="@color/primary"
            app:cornerRadius="14dp"
            app:icon="@drawable/ic_bolt"
            app:iconTint="@color/on_primary"
            app:iconGravity="textStart"
            android:layout_marginBottom="16dp"/>

        <EditText
            android:id="@+id/editSearch"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:hint="Search by station or reservation no."
            android:textColor="@color/text"
            android:textColorHint="@color/text_secondary"
            android:background="@drawable/edit_text_border"
            android:paddingHorizontal="16dp"
            android:inputType="text"
            android:layout_marginBottom="12dp"/>

        <Spinner
            android:id="@+id/spinnerFilter"
            android:layout_width="match_parent"
            android:layout_height="50dp"
            android:layout_marginBottom="20dp"
            android:background="@android:drawable/btn_dropdown" />

        <TextView
            android:id="@+id/textListStatus"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="12dp"
            android:textColor="@color/status_error"
            android:textSize="13sp"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/reservationsLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical" />
            
    </LinearLayout>
</ScrollView>
